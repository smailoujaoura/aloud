{
  "format": "aloud-site-rules/1",
  "updated": "2026-10-18",
  "rules": [
    { "id": "generic.citation-markers", "match": { "any": true },
      "skip": { "references": ["sup.reference", ".mw-ref", "[role=\"doc-noteref\"]", "a.footnote-ref", "a.footnote-reference", "sup[id^=\"fnref\"]", "[data-footnote-ref]", "a.footnote-anchor"] } },
    { "id": "generic.footnote-lists", "match": { "any": true },
      "skip": { "references": [".references", ".reflist", ".refbegin", ".footnotes", "div.footnote", ".footnote-list", "[data-footnotes]", ".mw-references-wrap", "[role=\"doc-endnotes\"]", "[role=\"doc-bibliography\"]", "[role=\"doc-footnote\"]"] } },
    { "id": "generic.end-matter-headings", "match": { "any": true },
      "skipSectionsAfterHeading": [
        { "as": "references", "pattern": "^(references|reference list|notes|notes and references|citations|footnotes|endnotes|bibliography|sources|works cited|further reading|external links|see also)$" },
        { "as": "references", "pattern": "^(note|note esplicative|bibliografia|voci correlate|altri progetti|collegamenti esterni|fonti|riferimenti|approfondimenti)$" },
        { "as": "references", "pattern": "^(einzelnachweise|anmerkungen|literatur|weblinks|siehe auch|quellen|belege|fußnoten)$" },
        { "as": "references", "pattern": "^(notes et références|références|bibliographie|liens externes|voir aussi|articles connexes)$" },
        { "as": "references", "pattern": "^(referencias|notas|bibliografía|enlaces externos|véase también|referências|ligações externas|ver também)$" }
      ] },
    { "id": "generic.edit-links", "match": { "any": true },
      "skip": { "always": [".mw-editsection", ".editsection", "a.post-edit-link", ".edit-link"] } },
    { "id": "generic.visually-hidden", "match": { "any": true },
      "skip": { "always": [".sr-only", ".visually-hidden", ".screen-reader-text", ".screen-reader-only", ".mw-jump-link", ".skip-link"] } },
    { "id": "generic.share", "match": { "any": true },
      "skip": { "always": ["#jp-post-flair", ".sharedaddy", ".sd-sharing", ".sd-like", ".addtoany_share_save_container", ".a2a_kit", ".shareaholic-canvas", ".social-share", ".share-buttons", ".post-share", ".post-share-buttons", ".wp-block-jetpack-sharing-buttons", ".wp-block-social-links"] } },
    { "id": "generic.related", "match": { "any": true },
      "skip": { "always": [".jp-relatedposts", "#jp-relatedposts", ".wp-block-jetpack-related-posts", ".yarpp-related", ".crp_related", ".related-posts", ".read-next"] } },
    { "id": "generic.subscribe", "match": { "any": true },
      "skip": { "always": [".wp-block-jetpack-subscriptions", ".jetpack_subscription_widget", ".mc4wp-form", ".subscription-widget-wrap", ".kg-signup-card", "[data-members-form]", ".newsletter-signup"] } },
    { "id": "generic.comments", "match": { "any": true },
      "skip": { "always": ["#comments", ".comments-area", ".comment-respond", "#respond", "#disqus_thread", ".commentlist", ".comment-list"] } },
    { "id": "generic.author-bio", "match": { "any": true },
      "skip": { "always": [".author-bio", ".author-box", ".about-author", ".saboxplugin-wrap", ".wp-block-post-author-biography", ".author-mini-bio"] } },
    { "id": "generic.breadcrumbs", "match": { "any": true },
      "skip": { "always": [".breadcrumb", ".breadcrumbs", "#breadcrumbs", ".yoast-breadcrumb", ".rank-math-breadcrumb", "[aria-label=\"breadcrumb\" i]", "[aria-label=\"breadcrumbs\" i]"] } },
    { "id": "generic.consent", "match": { "any": true },
      "skip": { "always": ["#onetrust-consent-sdk", "#CybotCookiebotDialog", "#cookie-notice", ".cc-window", ".cky-consent-container", "#didomi-host", ".fc-consent-root", "#usercentrics-root", ".qc-cmp2-container", "[id^=\"sp_message_container\"]", ".osano-cm-window"] } },
    { "id": "generic.ads", "match": { "any": true },
      "skip": { "always": ["ins.adsbygoogle", "[id^=\"div-gpt-ad\"]", "[id^=\"google_ads_iframe\"]", ".ad-slot", ".js-ad-slot", "[data-ad-slot]", ".advertisement"] } },
    { "id": "generic.toc", "match": { "any": true },
      "skip": { "always": ["#toc", ".toc", ".table-of-contents", "#ez-toc-container", ".ez-toc-container", ".lwptoc", ".wp-block-yoast-seo-table-of-contents", ".gh-toc", ".theme-doc-toc-mobile", ".theme-doc-toc-desktop", ".vector-toc"] } },
    { "id": "generic.code-labels", "match": { "any": true },
      "skip": { "code": [".code-block-caption", ".code-example .example-header", "[class*=\"codeBlockTitle\"]", ".highlight__panel"] } },
    { "id": "generic.phonetic", "match": { "any": true },
      "skip": { "always": [".IPA", ".ext-phonos"] } },
    { "id": "generic.short-apparatus-text", "match": { "any": true },
      "skipShortText": [
        { "maxChars": 40, "pattern": "^(was this (page|article|answer) helpful\\??|is this page helpful\\??|did this (page|article) help( you)?\\??)$" },
        { "maxChars": 30, "pattern": "^\\d+\\s*(min(ute)?s?|minuti|minutos)\\.?\\s*(read|de lecture|di lettura|de lectura|lesezeit|leestijd)$" },
        { "maxChars": 40, "pattern": "^(advertisement|anzeige|pubblicità|publicité|publicidad|sponsored)$" },
        { "maxChars": 60, "pattern": "^(skip (to|past) .+|after newsletter promotion)$" },
        { "maxChars": 30, "pattern": "^(share|share this( article| post)?:?|print|email|tweet)$" },
        { "maxChars": 90, "pattern": "^(this page was )?last (updated|modified|edited)\\b.*$" },
        { "maxChars": 60, "pattern": "^(edit this page|edit on github|view (this page|source) on github|report a problem with this content|learn how to contribute|help improve mdn)$" },
        { "maxChars": 20, "pattern": "^\\d[\\d,.]*\\s+(comments?|responses?|replies)$" },
        { "maxChars": 80, "pattern": "^(image|photo)( credits?)?:.*$" },
        { "maxChars": 30, "pattern": "^top comments( \\(\\d+\\))?$" }
      ] },

    { "id": "mediawiki", "match": { "generator": "^MediaWiki\\b" },
      "root": ["#mw-content-text > .mw-parser-output", ".mw-parser-output"],
      "skip": {
        "always": [".mw-editsection", ".hatnote", ".dablink", ".rellink", ".navigation-not-searchable", ".ambox", ".ombox", ".tmbox", ".cmbox", ".fmbox", ".imbox", ".mbox-small", ".metadata", ".navbox", ".navbox-styles", ".vertical-navbox", ".navbar", ".authority-control", ".sistersitebox", ".sisterproject", ".side-box", ".portalbox", ".sidebar", ".noprint", ".mw-empty-elt", ".shortdescription", "#siteSub", "#contentSub", ".mw-indicators", "#catlinks", ".catlinks", ".printfooter", "#coordinates", ".geo-default", ".IPA", ".infobox", ".infobox_v2", ".sinottico", ".taxobox"],
        "references": ["sup.reference", ".mw-ref", "sup.noprint.Inline-Template", ".Inline-Template", ".mw-references-wrap", ".reflist", ".refbegin", "ol.references", ".mw-cite-backlink"],
        "captions": ["figure[typeof^=\"mw:File\"] figcaption", ".thumbcaption", ".gallerytext"],
        "tables": ["table.wikitable"]
      } },
    { "id": "mediawiki.minerva", "match": { "generator": "^MediaWiki\\b", "selector": "body.skin-minerva" },
      "skip": { "always": [".pre-content .page-actions-menu", ".last-modified-bar", ".minerva-footer", "#page-secondary-actions"] } },
    { "id": "wikipedia.it", "match": { "host": ["it.wikipedia.org", "it.m.wikipedia.org"] },
      "skip": { "always": [".avviso", "table.CdA", ".nota-disambigua", ".vedi-anche"] } },
    { "id": "wikipedia.de", "match": { "host": ["de.wikipedia.org", "de.m.wikipedia.org"] },
      "skip": { "always": ["#Vorlage_Gesundheitshinweis", "#Vorlage_Rechtshinweis", "#Vorlage_Dieser_Artikel", ".sieheauch", ".hauptartikel", "#normdaten"] },
      "skipSectionsAfterHeading": [{ "as": "references", "pattern": "^(studien|dokumentationen|filme|hörspiele)$" }] },

    { "id": "wordpress", "match": { "generator": "^WordPress" },
      "root": [".entry-content", ".wp-block-post-content", ".post-content"],
      "skip": { "always": [".entry-footer", ".entry-meta", ".post-meta", ".posted-on", ".cat-links", ".tags-links", ".post-tags", ".wp-block-post-terms", ".comments-area", ".comment-respond", ".post-navigation", ".screen-reader-text"],
                "captions": [".wp-element-caption", ".wp-caption-text", ".blocks-gallery-caption"] } },
    { "id": "wordpress.com-blog", "match": { "host": ["wordpress.com"] },
      "root": ["article .post-content.entrytext"],
      "skip": { "always": [".wpblog-post-hero__meta-data", "#entry-comments", "section.wpblog-signup", ".wpblog-page-cat-nav"] } },
    { "id": "techcrunch", "match": { "host": ["techcrunch.com"] },
      "root": [".entry-content.wp-block-post-content"],
      "skip": { "always": [".article-sidebar", ".wp-block-techcrunch-event-cta", ".wp-block-techcrunch-most-popular-posts", ".wp-block-tc23-post-relevant-terms", "p.affiliate-disclaimer-text", ".wp-block-techcrunch-post-authors"] } },
    { "id": "arstechnica", "match": { "host": ["arstechnica.com"] },
      "skip": { "always": [".author-mini-bio", ".story-tools", ".text-settings-dropdown-story", ".upper-deck", "a.view-comments"] } },
    { "id": "substack", "match": { "selector": "#entry .available-content .body.markup" },
      "root": [".available-content .body.markup"],
      "skip": { "always": [".post-header .byline-wrapper", ".post-ufi", ".subscription-widget-wrap", "p.button-wrapper", "#discussion", ".post-footer"],
                "references": ["a.footnote-anchor", "div.footnote"], "captions": ["figcaption.image-caption"] } },
    { "id": "ghost", "match": { "generator": "^Ghost\\b" },
      "root": [".gh-content", ".post-content", ".kg-canvas"],
      "skip": { "always": [".kg-bookmark-card", ".gh-toc", ".gh-sticky-sidebar", ".gh-post-meta", ".kg-signup-card", "[data-members-form]", ".gh-post-upgrade-cta", ".gh-read-next"], "captions": [".kg-card figcaption"] } },
    { "id": "medium", "match": { "host": ["medium.com", "*.medium.com"] },
      "skip": { "always": [".speechify-ignore", "[data-testid=\"authorName\"]", "[data-testid=\"headerClapButton\"]", ".pw-multi-vote-count"] } },
    { "id": "devto", "match": { "host": ["dev.to"] },
      "root": ["#article-body"],
      "skip": { "always": ["#comments", ".ltag__link", "#article-show-more-dropdown"], "code": [".highlight__panel"] } },
    { "id": "bbc", "match": { "host": ["www.bbc.com", "www.bbc.co.uk"] },
      "root": ["main article", "article"],
      "skip": { "always": ["[data-component=\"byline-block\"]", "[data-component=\"links-block\"]", "[data-component=\"tag-list-block\"]", "[data-testid=\"byline\"]", "[data-component=\"image-block\"] [class*=\"CreditStyled\"]"],
                "captions": ["[data-component=\"image-block\"] figcaption", "[data-component=\"video-block\"]"] } },
    { "id": "guardian", "match": { "host": ["www.theguardian.com"] },
      "skip": { "always": ["[data-gu-name=\"meta\"]", "gu-island[name=\"ShareButton\"]", "gu-island[name=\"EmailSignUpWrapper\"]", "[id^=\"EmailSignup-skip-link\"]", "a[href^=\"#EmailSignup-skip-link\"]", "gu-island[name=\"SlotBodyEnd\"]", "#sign-in-gate", ".ad-slot", "gu-island[name=\"OnwardsUpper\"]", "gu-island[name=\"MostViewedRightWithAd\"]", "gu-island[name=\"DiscussionWeb\"]"],
                "captions": ["#the-caption", "[data-gu-name=\"media\"] figcaption"] } },
    { "id": "mdn", "match": { "host": ["developer.mozilla.org"] },
      "skip": { "always": [".baseline-indicator", "section.article-footer", "fieldset.content-feedback", ".reference-toc", "interactive-example", "mdn-compat-table-lazy"],
                "code": [".code-example .example-header"], "tables": ["table.standard-table"] } },
    { "id": "docusaurus", "match": { "generator": "^Docusaurus" },
      "root": ["article .theme-doc-markdown", "article"],
      "skip": { "always": [".theme-doc-version-badge", ".theme-doc-toc-mobile", ".theme-doc-toc-desktop", ".theme-doc-breadcrumbs", ".theme-doc-footer", ".pagination-nav"], "code": ["[class*=\"codeBlockTitle\"]"] } },
    { "id": "mkdocs-material", "match": { "generator": "mkdocs-material" },
      "root": ["article.md-content__inner"],
      "skip": { "always": ["form.md-feedback", ".md-source-file", ".md-content__button", ".md-annotation__index"], "references": ["sup[id^=\"fnref\"]", "a.footnote-ref", "div.footnote"] } },
    { "id": "sphinx", "match": { "selector": "div.body[role=\"main\"], .rst-content [itemprop=\"articleBody\"]" },
      "root": ["[itemprop=\"articleBody\"]", "div.body[role=\"main\"]"],
      "skip": { "always": [".wy-breadcrumbs", ".rst-footer-buttons", "readthedocs-flyout", ".rst-versions", "div.related", ".sphinxsidebar"], "references": ["a.footnote-reference", "aside.footnote-list"], "code": [".code-block-caption"] } },
    { "id": "gitbook", "match": { "generator": "^GitBook" },
      "skip": { "always": ["[data-testid=\"table-of-contents\"]", "[data-testid=\"ai-chat\"]"] } },
    { "id": "github", "match": { "host": ["github.com"] },
      "root": ["article.markdown-body"],
      "skip": { "references": ["[data-footnote-ref]", "section[data-footnotes]"] } },
    { "id": "webflow", "match": { "generator": "^Webflow" },
      "skip": { "always": [".w-webflow-badge", ".w-nav", ".w-nav-overlay"] } },
    { "id": "theitalianexperiment", "match": { "host": ["*.theitalianexperiment.com", "theitalianexperiment.com"] },
      "root": ["section.x-storycontent > .x-wrap", ".x-wrap"],
      "skip": { "always": [".footerwrapper", ".x-header .y-player-buttons", ".x-ffs", ".x-alltrans-container", ".trans-link", ".swell"] } }
  ]
}
